<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn" onclick="goBack" style="background-color: {{ theme.card }}; border-color: {{ theme.border }}">
        <text class="back-btn-text" style="color: {{ theme.accent }}">◀ 返回</text>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">激活码系统 V2</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">加密生成</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">16位纯数字激活码：产品ID(4位) + 设备哈希(4位) + 天数(4位) + 校验码(4位)</text>

      <text class="field-label" style="color: {{ theme.text }}">预设设备ID</text>
      <div class="preset-grid">
        <div class="preset-btn" onclick="presetEncrypt('Aa09', '0001', 30)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">Aa09/30天</text>
        </div>
        <div class="preset-btn" onclick="presetEncrypt('Bb19', '0001', 90)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">Bb19/90天</text>
        </div>
        <div class="preset-btn" onclick="presetEncrypt('Xy99', '0001', 365)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">Xy99/365天</text>
        </div>
        <div class="preset-btn" onclick="presetEncrypt('AbCd', '0001', 9999)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">AbCd/永久</text>
        </div>
        <div class="preset-btn" onclick="presetEncrypt('TeSt', '0001', 7)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">TeSt/7天</text>
        </div>
        <div class="preset-btn" onclick="presetEncrypt('DeMo', '0001', 180)" style="background-color: {{ theme.border }}; border-color: {{ theme.border }}">
          <text class="preset-text" style="color: {{ theme.text }}">DeMo/180天</text>
        </div>
      </div>

      <text class="field-label" style="color: {{ theme.text }}">产品ID</text>
      <div class="product-select-row">
        <div class="product-option {{ selectedProductId === '0001' ? 'product-option-active' : '' }}" onclick="selectProduct('0001')" style="background-color: {{ selectedProductId === '0001' ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
          <text class="product-option-text" style="color: {{ selectedProductId === '0001' ? theme.bg : theme.text }}">0001 课程表</text>
        </div>
        <div class="product-option {{ selectedProductId === '0002' ? 'product-option-active' : '' }}" onclick="selectProduct('0002')" style="background-color: {{ selectedProductId === '0002' ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
          <text class="product-option-text" style="color: {{ selectedProductId === '0002' ? theme.bg : theme.text }}">0002 表盘</text>
        </div>
        <div class="product-option {{ selectedProductId === '0003' ? 'product-option-active' : '' }}" onclick="selectProduct('0003')" style="background-color: {{ selectedProductId === '0003' ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
          <text class="product-option-text" style="color: {{ selectedProductId === '0003' ? theme.bg : theme.text }}">0003 健康</text>
        </div>
        <div class="product-option {{ selectedProductId === '9999' ? 'product-option-active' : '' }}" onclick="selectProduct('9999')" style="background-color: {{ selectedProductId === '9999' ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
          <text class="product-option-text" style="color: {{ selectedProductId === '9999' ? theme.bg : theme.text }}">全通</text>
        </div>
      </div>

      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">设备ID</text>
        <div class="text-input" onclick="inputDeviceId" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ customDeviceId ? theme.text : theme.textMuted }}">{{ customDeviceId || '点击输入设备ID' }}</text>
        </div>
      </div>
      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">天数</text>
        <div class="text-input" onclick="inputDays" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ customDays ? theme.text : theme.textMuted }}">{{ customDays || '点击输入天数（9999=永久）' }}</text>
        </div>
      </div>
      <div class="generate-btn" onclick="generateCustom" style="background-color: {{ theme.accent }}">
        <text class="generate-btn-text" style="color: {{ theme.bg }}">生成激活码</text>
      </div>

      <div class="result-box" show="{{ encryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ theme.accent }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">加密结果</text>
        <text class="result-code" style="color: {{ theme.accent }}">{{ encryptResult }}</text>
        <text class="result-detail" style="color: {{ theme.textSecondary }}">{{ encryptDetail }}</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <text class="section-title" style="color: {{ theme.text }}">解密验证</text>
      <text class="section-desc" style="color: {{ theme.textSecondary }}">16位纯数字，支持新格式；12位含字母旧格式自动兼容</text>

      <div class="cells-grid" style="background-color: {{ theme.bg }}">
        <div class="cells-row">
          <div class="cell {{ cursor === 0 ? 'cell-active' : '' }}" onclick="onCellClick(0)" style="background-color: {{ cursor === 0 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 0 ? theme.bg : theme.text }}">{{ cell0 !== null ? cell0 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 1 ? 'cell-active' : '' }}" onclick="onCellClick(1)" style="background-color: {{ cursor === 1 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 1 ? theme.bg : theme.text }}">{{ cell1 !== null ? cell1 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 2 ? 'cell-active' : '' }}" onclick="onCellClick(2)" style="background-color: {{ cursor === 2 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 2 ? theme.bg : theme.text }}">{{ cell2 !== null ? cell2 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 3 ? 'cell-active' : '' }}" onclick="onCellClick(3)" style="background-color: {{ cursor === 3 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 3 ? theme.bg : theme.text }}">{{ cell3 !== null ? cell3 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 4 ? 'cell-active' : '' }}" onclick="onCellClick(4)" style="background-color: {{ cursor === 4 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 4 ? theme.bg : theme.text }}">{{ cell4 !== null ? cell4 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 5 ? 'cell-active' : '' }}" onclick="onCellClick(5)" style="background-color: {{ cursor === 5 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 5 ? theme.bg : theme.text }}">{{ cell5 !== null ? cell5 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 6 ? 'cell-active' : '' }}" onclick="onCellClick(6)" style="background-color: {{ cursor === 6 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 6 ? theme.bg : theme.text }}">{{ cell6 !== null ? cell6 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 7 ? 'cell-active' : '' }}" onclick="onCellClick(7)" style="background-color: {{ cursor === 7 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 7 ? theme.bg : theme.text }}">{{ cell7 !== null ? cell7 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 8 ? 'cell-active' : '' }}" onclick="onCellClick(8)" style="background-color: {{ cursor === 8 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 8 ? theme.bg : theme.text }}">{{ cell8 !== null ? cell8 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 9 ? 'cell-active' : '' }}" onclick="onCellClick(9)" style="background-color: {{ cursor === 9 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 9 ? theme.bg : theme.text }}">{{ cell9 !== null ? cell9 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 10 ? 'cell-active' : '' }}" onclick="onCellClick(10)" style="background-color: {{ cursor === 10 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 10 ? theme.bg : theme.text }}">{{ cell10 !== null ? cell10 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 11 ? 'cell-active' : '' }}" onclick="onCellClick(11)" style="background-color: {{ cursor === 11 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 11 ? theme.bg : theme.text }}">{{ cell11 !== null ? cell11 : '-' }}</text>
          </div>
        </div>
        <div class="cells-row">
          <div class="cell {{ cursor === 12 ? 'cell-active' : '' }}" onclick="onCellClick(12)" style="background-color: {{ cursor === 12 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 12 ? theme.bg : theme.text }}">{{ cell12 !== null ? cell12 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 13 ? 'cell-active' : '' }}" onclick="onCellClick(13)" style="background-color: {{ cursor === 13 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 13 ? theme.bg : theme.text }}">{{ cell13 !== null ? cell13 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 14 ? 'cell-active' : '' }}" onclick="onCellClick(14)" style="background-color: {{ cursor === 14 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 14 ? theme.bg : theme.text }}">{{ cell14 !== null ? cell14 : '-' }}</text>
          </div>
          <div class="cell {{ cursor === 15 ? 'cell-active' : '' }}" onclick="onCellClick(15)" style="background-color: {{ cursor === 15 ? theme.accent : theme.bg }}; border-color: {{ theme.border }}">
            <text class="cell-text" style="color: {{ cursor === 15 ? theme.bg : theme.text }}">{{ cell15 !== null ? cell15 : '-' }}</text>
          </div>
        </div>
      </div>

      <div class="keypad" style="background-color: {{ theme.bg }}">
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(1)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">1</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(2)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">2</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(3)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">3</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(4)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">4</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(5)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">5</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(6)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">6</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn" onclick="onKeyPress(7)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">7</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(8)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">8</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(9)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">9</text>
          </div>
        </div>
        <div class="keypad-row">
          <div class="keypad-btn keypad-clear" onclick="onClear" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">C</text>
          </div>
          <div class="keypad-btn" onclick="onKeyPress(0)" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: {{ theme.text }}">0</text>
          </div>
          <div class="keypad-btn keypad-delete" onclick="onDelete" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
            <text class="keypad-text" style="color: #e74c3c">←</text>
          </div>
        </div>
      </div>

      <div class="input-row">
        <text class="input-prefix" style="color: {{ theme.textSecondary }}">设备ID</text>
        <div class="text-input" onclick="inputVerifyDeviceId" style="background-color: {{ theme.bg }}; border-color: {{ theme.border }}">
          <text class="input-text" style="color: {{ verifyDeviceId ? theme.text : theme.textMuted }}">{{ verifyDeviceId || '点击输入验证设备ID（可选）' }}</text>
        </div>
      </div>

      <div class="generate-btn" onclick="doDecrypt" style="background-color: {{ theme.accent }}">
        <text class="generate-btn-text" style="color: {{ theme.bg }}">解密验证</text>
      </div>

      <div class="result-box" show="{{ decryptResult }}" style="background-color: {{ theme.bg }}; border-color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">
        <text class="result-label" style="color: {{ theme.textSecondary }}">解密结果</text>
        <text class="result-code" style="color: {{ decryptSuccess ? theme.accent : '#e74c3c' }}">{{ decryptResult }}</text>
        <text class="result-detail" show="{{ decryptDetail }}" style="color: {{ theme.textSecondary }}">{{ decryptDetail }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")

function doVibrate() {
  try {
    vibrator.vibrate({ mode: "short" })
  } catch (e) {}
}

export default {
  private: {
    theme: {},
    customDeviceId: '',
    customDays: '',
    selectedProductId: '0001',
    encryptResult: '',
    encryptDetail: '',
    verifyDeviceId: '',
    cell0: null, cell1: null, cell2: null, cell3: null,
    cell4: null, cell5: null, cell6: null, cell7: null,
    cell8: null, cell9: null, cell10: null, cell11: null,
    cell12: null, cell13: null, cell14: null, cell15: null,
    cursor: 0,
    decryptResult: '',
    decryptDetail: '',
    decryptSuccess: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    self.loadDemoCode()
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    var storage = require("@system.storage")
    storage.get({
      key: "activation_lab_device_id",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.customDeviceId = data
          storage.delete({ key: "activation_lab_device_id" })
        }
      }
    })
    storage.get({
      key: "activation_lab_days",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.customDays = data
          storage.delete({ key: "activation_lab_days" })
        }
      }
    })
    storage.get({
      key: "activation_lab_verify_device_id",
      success: function(data) {
        if (data !== undefined && data !== null) {
          self.verifyDeviceId = data
          storage.delete({ key: "activation_lab_verify_device_id" })
        }
      }
    })
  },

  goBack() {
    router.back()
  },

  selectProduct(productId) {
    doVibrate()
    this.selectedProductId = productId
  },

  loadDemoCode() {
    var demo = authStore.encryptV2("Aa09", "0001", 30)
    if (demo && demo.full) {
      var code = demo.full
      for (var i = 0; i < 16; i++) {
        this['cell' + i] = code[i]
      }
    }
  },

  onCellClick(index) {
    doVibrate()
    this.cursor = index
  },

  onKeyPress(digit) {
    doVibrate()
    var idx = this.cursor
    this['cell' + idx] = digit
    if (this.cursor < 15) {
      this.cursor = this.cursor + 1
    }
  },

  onDelete() {
    doVibrate()
    var idx = this.cursor
    if (this['cell' + idx] === null || this['cell' + idx] === undefined) {
      if (this.cursor > 0) {
        this.cursor = this.cursor - 1
        idx = this.cursor
      }
    }
    this['cell' + idx] = null
    if (this.cursor > 0) {
      this.cursor = this.cursor - 1
    }
  },

  onClear() {
    doVibrate()
    for (var i = 0; i < 16; i++) {
      this['cell' + i] = null
    }
    this.cursor = 0
  },

  inputDeviceId() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "设备ID" })
    storage.set({ key: "chinese_input_placeholder", value: "输入设备ID（如 Aa09）" })
    storage.set({ key: "chinese_input_value", value: this.customDeviceId || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_device_id" })
    router.push({ uri: "/pages/chinese-input" })
  },

  inputDays() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "天数" })
    storage.set({ key: "chinese_input_placeholder", value: "输入天数（9999=永久）" })
    storage.set({ key: "chinese_input_value", value: this.customDays || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_days" })
    router.push({ uri: "/pages/chinese-input" })
  },

  inputVerifyDeviceId() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "验证设备ID" })
    storage.set({ key: "chinese_input_placeholder", value: "输入用于验证的设备ID" })
    storage.set({ key: "chinese_input_value", value: this.verifyDeviceId || "" })
    storage.set({ key: "chinese_input_maxlen", value: "4" })
    storage.set({ key: "chinese_input_return_key", value: "activation_lab_verify_device_id" })
    router.push({ uri: "/pages/chinese-input" })
  },

  presetEncrypt(deviceId, productId, days) {
    var result = authStore.encryptV2(deviceId, productId, days)
    if (!result) {
      this.encryptResult = '参数无效'
      this.encryptDetail = ''
      return
    }
    this.encryptResult = authStore.fmtCode16(result.full)
    this.encryptDetail = '产品: ' + result.productName + ' | 设备ID: ' + deviceId + ' | 哈希: ' + result.idHash + ' | 天数: ' + days + '天 | 校验: ' + result.checksum
  },

  generateCustom() {
    var deviceId = this.customDeviceId.trim()
    var days = parseInt(this.customDays.trim(), 10)
    if (!deviceId) {
      this.encryptResult = '请输入设备ID'
      this.encryptDetail = ''
      return
    }
    if (isNaN(days) || days < 1 || days > 9999) {
      this.encryptResult = '天数需在1-9999之间'
      this.encryptDetail = ''
      return
    }
    this.presetEncrypt(deviceId, this.selectedProductId, days)
  },

  doDecrypt() {
    var code = ''
    for (var i = 0; i < 16; i++) {
      code += this['cell' + i] || '0'
    }

    var deviceId = this.verifyDeviceId.trim()
    var result
    var codeTrimmed = code.replace(/\s/g, '')

    if (deviceId) {
      result = authStore.verifyActivationAuto(codeTrimmed, deviceId, this.selectedProductId)
    } else {
      result = authStore.decryptAuto(codeTrimmed)
      if (result) {
        result = {
          success: true,
          productId: result.productId || '0001',
          productName: result.productName || 'EV课程表',
          days: result.days,
          isPermanent: result.isPermanent
        }
      } else {
        result = { success: false, reason: '激活码无效' }
      }
    }

    if (result.success) {
      this.decryptSuccess = true
      if (result.isPermanent) {
        this.decryptResult = '验证通过 - 永久激活'
      } else {
        this.decryptResult = '验证通过 - ' + result.days + ' 天'
      }
      this.decryptDetail = '产品: ' + (result.productName || '未知') + ' (' + (result.productId || '0001') + ') | ' + (result.isPermanent ? '永久授权' : result.days + '天')

      authStore.markActivated(result.isPermanent ? -1 : result.days, result.productId, function(success) {
        if (success) {
          prompt.showToast({ message: '已保存激活状态' })
        }
      })
    } else {
      this.decryptSuccess = false
      this.decryptResult = result.reason || '验证失败'
      this.decryptDetail = ''
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  padding: 36px 6px 6px 6px;
  min-height: 100%;
  align-items: center;
}

.back-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
  width: 100%;
}

.back-btn {
  width: 56px;
  height: 28px;
  border-radius: 8px;
  border-width: 1px;
  border-style: solid;
  justify-content: center;
  align-items: center;
}

.back-btn-text {
  font-size: 13px;
}

.header-title {
  font-size: 16px;
  font-weight: bold;
  margin-left: 6px;
}

.section {
  flex-direction: column;
  border-radius: 10px;
  padding: 10px 8px;
  margin-bottom: 8px;
  width: 100%;
}

.section-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 3px;
}

