{
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/api/oauth/login", "destination": "/api/oauth", "permanent": false },
    { "source": "/api/oauth/callback", "destination": "/api/oauth", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/afdian/query-orders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/health?section=backup&cron=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/health?section=sync&cron=1",
      "schedule": "0 5 * * *"
    }
  ]
}